library(tidyverse)
library(readr)
library(dplyr)
library(tidyr)
library(stringr)
library(usmap)
##Edit below to be path to you Table_1 download in your computer (from Opportunity Atlas)
opportunityData <- read_csv("C:\\Users\\mcpro\\OneDrive\\Documents\\R studio\\Table_1_county_trends_estimates (1).csv")
data_clean <- opportunityData %>% select(-starts_with("kfr"))
data_clean <- data_clean %>% select(-starts_with("change"))
data_clean <- data_clean %>% select(-ends_with("reliab"))
data_clean_counts <- data_clean %>% select(ends_with("count"))
data_clean <- data_clean %>% select(-ends_with("count"))
data_1978 <- data_clean %>% select(-ends_with("1992"))
data_1992 <- data_clean %>% select(-ends_with("1978"))
dat_long <- data_clean %>% pivot_longer(
cols = -c("state", "county", "state_name", "county_name")
)
dat_long_clean <- dat_long %>%
separate_wider_delim(cols = "name", delim= "_", names = c("metric", "race", "gender", "percentile", "cohort")) %>%
filter(race != "pooled", gender !="pooled")
dat_long_clean_emp <- dat_long_clean %>% filter(metric == "emp") %>% select(-("metric")) %>% rename(frac_child_emp = value)
dat_long_clean_fpw <- dat_long_clean %>% filter(metric == "fpw") %>% select(-("metric")) %>% rename(frac_parent_emp = value)
dat_long_clean_kfi <- dat_long_clean %>% filter(metric == "kfi") %>% select(-("metric")) %>% rename(mean_house_income = value)
dat_long_clean_kii <- dat_long_clean %>% filter(metric == "kii") %>% select(-("metric")) %>% rename(mean_indiv_income = value)
dat_long_clean_kir <- dat_long_clean %>% filter(metric == "kir") %>% select(-("metric")) %>% rename(mean_percentile_rank = value)
dat_long_clean_merged <- merge(dat_long_clean_emp, dat_long_clean_fpw, by = c("state", "county", "state_name", "county_name", "race", "gender", "percentile", "cohort"))
dat_long_clean_merged <- merge(dat_long_clean_merged, dat_long_clean_kfi, by = c("state", "county", "state_name", "county_name", "race", "gender", "percentile", "cohort"))
dat_long_clean_merged <- merge(dat_long_clean_merged, dat_long_clean_kii, by = c("state", "county", "state_name", "county_name", "race", "gender", "percentile", "cohort"))
dat_long_clean_merged <- merge(dat_long_clean_merged, dat_long_clean_kir, by = c("state", "county", "state_name", "county_name", "race", "gender", "percentile", "cohort"))
dat_long_clean_merged$percentile <- factor(dat_long_clean_merged$percentile, levels = c("p1", "p25", "p50", "p75", "p100"), ordered = TRUE)
write.csv(dat_long_clean_merged, file = "dat_long_clean_merged.csv", row.names = FALSE)
#Removes “p” from the front of the percentile (p1 → 1) so they may be treated as numbers.
dat_long_clean_merged_edited <- dat_long_clean_merged %>%
mutate(percentile = str_remove(percentile, "p") %>% as.numeric())
#Na.omit removes missing values from the data, cleaning our final dataset to include only
#what we actually have recorded data for.
dat_long_clean_merged_edited <- na.omit(dat_long_clean_merged_edited)
##Path to RUCC csv from Census Bureau for 1974
data74 <- read_csv("C:\\Users\\mcpro\\Downloads\\ruralurbancodes1974 (1).csv")
data74 <- data74 %>% select(-"...5")
data74 <- data74 %>% select(-"...6")
data74 <- data74 %>% select(-"...7")
##Path to RUCC csv from Census Bureau for 1993
data93 <- read_csv("C:\\Users\\mcpro\\Downloads\\code93 (2).csv")
dlcme <- dat_long_clean_merged_edited %>% mutate(`FIPS Code` = str_pad(state * 1000 + county, width = 5, pad = "0"))
dlcme78 <- dlcme %>% filter(cohort=="1978")
dlcme92 <- dlcme %>% filter(cohort=="1992")
dlcme78 <- merge(dlcme78, data74, by = c("FIPS Code"))
dlcme78 <- dlcme78 %>% rename(continuum_code = "1974 Rural-urban Continuum Code")
dlcme92 <- merge(dlcme92, data93, by = c("FIPS Code"))
dlcme92 <- dlcme92 %>% rename(continuum_code = "Rural-urban Continuuum Code, 1993")
data1.0 <- rbind(dlcme78, dlcme92)
data1.0 <- data1.0 %>% select(-"County Name")
data1.0 <- data1.0 %>% select(-"State")
data <- data1.0
dataP25 <- data %>% filter(percentile==25)
data2578 <- dataP25%>%filter(cohort==1978)
data2592 <- dataP25%>%filter(cohort==1992)
lm78 <- lm(mean_indiv_income ~ continuum_code * race + gender, data=data2578)
lm92 <- lm(mean_indiv_income ~ continuum_code * race + gender, data=data2592)
summary(lm78)
summary(lm92)
dataP1 <- data %>% filter(percentile == 1)
lm1st <- lm(mean_indiv_income ~ continuum_code + race + gender, data=dataP1)
summary(lm1st)
dataP25 <- data %>% filter(percentile==25)
lm25th <- lm(mean_indiv_income ~ continuum_code + race + gender, data=dataP25)
summary(lm25th)
dataP50 <- data %>% filter(percentile==50)
lm50th <- lm(mean_indiv_income ~ continuum_code + race + gender, data=dataP50)
summary(lm50th)
dataP75 <- data %>% filter(percentile==75)
lm75th <- lm(mean_indiv_income ~ continuum_code + race + gender, data=dataP75)
summary(lm75th)
dataP100 <- data %>% filter(percentile==100)
lm100th <- lm(mean_indiv_income ~ continuum_code + race + gender, data=dataP100)
summary(lm100th)
confint(lm25th, level = 0.95)
# Fit your model
model <- lm25th
# Set up a 2x3 layout (6 panels)
par(mfrow = c(2, 3), mar = c(4, 4, 2, 1))  # adjust margins
# Panel 1: Residuals vs Fitted
plot(lm25th$fitted.values, resid(lm25th),
xlab = "Fitted values", ylab = "Residuals",
main = "Residuals vs. Fitted", pch = 1)
abline(h = 0, col = "red", lty = 2)
# Panel 2: Histogram of residuals
hist(residuals(model),
breaks = 50,                    # More bins for detail
col = "lightgray",
border = "white",
main = "Histogram of Residuals",
xlab = "Residuals",
xlim = c(-50000, 50000))        # Focus on central range
# Panel 3: Normal Q-Q plot
qqnorm(resid(lm25th), main = "Normal Q-Q Plot")
qqline(resid(lm25th), col = "black", lty = 2)
# Panel 4–6: Residuals vs key predictors
# Get model residuals and the model frame (data actually used)
resid_vals <- resid(lm25th)
model_data <- model.frame(lm25th)
model_data$gender <- as.factor(model_data$gender)
model_data$race <- as.factor(model_data$race)
# Residuals vs Continuum Code
plot(model_data$continuum_code, resid_vals,
xlab = "Continuum Code", ylab = "Residuals",
main = "Residuals vs. Continuum Code", pch = 1)
abline(h = 0, col = "red", lty = 2)
# Residuals vs Race
plot(model_data$race, resid_vals,
xlab = "Race", ylab = "Residuals",
main = "Residuals vs. Race", pch = 1)
abline(h = 0, col = "red", lty = 2)
# Residuals vs Gender
plot(model_data$gender, resid_vals,
xlab = "Gender", ylab = "Residuals",
main = "Residuals vs. Gender", pch = 1)
abline(h = 0, col = "red", lty = 2)
plot(lm25th, which = 5)
