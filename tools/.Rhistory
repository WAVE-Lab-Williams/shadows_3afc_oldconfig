table <- table |> mutate(chosen_object = str_remove_all(chosen_image,"^obj|_sha.*"))
table <- table |> mutate(consistent_object = chosen_object == target_object)
table <- table |> mutate(consistent_shadow = chosen_object == target_shadow)
table <- table |> mutate(all_object = consistent_object & consistent_shadow)
table <- table |> mutate(neither = (chosen_object != target_object) & (chosen_object != target_shadow))
V1_3 <- V1_3 |> mutate(chosen_object = str_remove_all(chosen_image,"^obj|_sha.*"))
V1_3 <- V1_3 |> mutate(consistent_object = chosen_object == target_object)
V1_3 <- V1_3 |> mutate(consistent_shadow = chosen_object == target_shadow)
V1_3 <- V1_3 |> mutate(all_object = consistent_object & consistent_shadow)
V1_3 <- V1_3 |> mutate(neither = (chosen_object != target_object) & (chosen_object != target_shadow))
#new 2/20/26 Separate for bevel trials
table <- table |>
mutate(bevel = str_detect(afc_order, "bevel"))
expt2 |>
mutate(combined = paste(target_object, target_shadow, sep = "_sha")) |>
pivot_longer( #join columns
cols = c(consistent_object, consistent_shadow, all_object, neither),
names_to = "Response_Type",
values_to = "Status"
) |>
filter(Status == TRUE) |> #count true values
#merge with as factor logic for timing
ggplot(aes(x = combined, fill = Response_Type)) +
geom_bar(position = "stack") +
scale_fill_discrete(
labels = c(
"neither" = "Neither",
"all_object" = "Both",
"consistent_object" = "Object",
"consistent_shadow" = "Shadow"
)
) +
labs(
title = "Experiment 2 By Study Permutations",
x = "Image Presented",
y = "Count",
fill = "Category"
) +
theme_minimal()
